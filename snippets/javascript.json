{
  "variable-console-log": {
    "prefix": ["vlog"],
    "body": ["console.log('$1 :', $1)"]
  },
  "async fetch": {
    "prefix": ["af"],
    "body": [
      "async fetchData() {",
      "\ttry {",
      "\t\tconst res = await",
      "\t} catch (err) {",
      "\t\tconsole.log('err :', err)",
      "\t} finally {",
      "\t\tconsole.log('finally')",
      "\t}",
      "}"
    ]
  }
}
